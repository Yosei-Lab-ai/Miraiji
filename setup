#!/usr/bin/env bash
set -euo pipefail

MIRAIJI_DIR="$(cd "$(dirname "$0")" && pwd)"
SKILLS_ROOT="${HOME}/.claude/skills"
DATA_DIR="${HOME}/.miraiji"
SKILLS=(persona pricing gtm market-scan bizplan launch content outreach measure grow feedback biz-retro)

is_expected_link() {
    local source="$1" target="$2" actual expected
    if [ -L "$target" ] && [ "$(readlink "$target")" = "$source" ]; then
        return 0
    fi
    case "$(uname -s)" in
        MINGW*|MSYS*|CYGWIN*)
            command -v powershell.exe >/dev/null 2>&1 || return 1
            command -v cygpath >/dev/null 2>&1 || return 1
            [ -d "$target" ] || return 1
            actual="$(powershell.exe -NoProfile -Command "(Get-Item -LiteralPath '$(cygpath -w "$target")').Target" 2>/dev/null | tr -d '\r')"
            expected="$(cygpath -w "$source")"
            [ "${actual,,}" = "${expected,,}" ]
            ;;
        *) return 1 ;;
    esac
}

link_skill() {
    local skill="$1"
    local source="${MIRAIJI_DIR}/${skill}"
    local target="${SKILLS_ROOT}/${skill}"

    if is_expected_link "$source" "$target"; then
        echo "[skip] /${skill} already linked"
        return
    fi
    if [ -e "$target" ] || [ -L "$target" ]; then
        echo "[FAIL] ${target} already exists and is not the expected Miraiji link." >&2
        echo "       Move it aside explicitly, then rerun setup." >&2
        exit 2
    fi

    case "$(uname -s)" in
        MINGW*|MSYS*|CYGWIN*)
            if ! command -v cmd.exe >/dev/null 2>&1 || ! command -v cygpath >/dev/null 2>&1; then
                echo "[FAIL] Windows junction setup requires cmd.exe and cygpath." >&2
                exit 2
            fi
            cmd.exe /c mklink /J "$(cygpath -w "$target")" "$(cygpath -w "$source")" >/dev/null
            ;;
        *) ln -s "$source" "$target" ;;
    esac
    echo "[done] /${skill}: ${target} -> ${source}"
}

echo "=== Miraiji Setup ==="
mkdir -p "$SKILLS_ROOT"
for skill in "${SKILLS[@]}"; do
    link_skill "$skill"
done

mkdir -p "$DATA_DIR"/{personas,pricing,gtm,market,plans,launch/materials,content,growth,feedback,retros,experiments,state}
if [ ! -e "$DATA_DIR/state/current.md" ]; then
    printf '%s\n' \
        '---' \
        'status: ready' \
        'last_completed: setup' \
        'next_skill: persona' \
        'pending_hypothesis: null' \
        'external_action_authorized: false' \
        '---' \
        '' \
        '# Resume' \
        '' \
        'Run `/persona`. Planning does not authorize launch, publication, outreach, billing, purchases, or customer-facing changes.' \
        > "$DATA_DIR/state/current.md"
fi

echo ""
echo "=== Miraiji installed ==="
echo "Data root: ${DATA_DIR}"
echo "Resume pointer: ${DATA_DIR}/state/current.md"
echo "Approval boundary: hypotheses and test plans do not authorize launch, publication, outreach, billing, or price changes."
echo "Start with /persona, then /pricing and /gtm."
